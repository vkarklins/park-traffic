OPENAI_API_KEY=sk-...

# Laminar (self-hosted, the default backend). Project API key from the Laminar UI:
# Settings -> Project API Keys.
LMNR_PROJECT_API_KEY=...
LMNR_BASE_URL=http://localhost
LMNR_HTTP_PORT=8000
LMNR_GRPC_PORT=8001

# Raindrop (only for --telemetry raindrop)
RAINDROP_WRITE_KEY=...
# Raindrop project slug (create it first under Settings -> Projects)
RAINDROP_PROJECT_ID=park-demo
